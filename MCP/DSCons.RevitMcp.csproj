<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(RevitTargetFramework)' != ''">$(RevitTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(RevitTargetFramework)' == '' and ('$(RevitVersion)' == '2019' or '$(RevitVersion)' == '2020')">net47</TargetFramework>
    <TargetFramework Condition="'$(RevitTargetFramework)' == '' and ('$(RevitVersion)' == '2021' or '$(RevitVersion)' == '2022' or '$(RevitVersion)' == '2023' or '$(RevitVersion)' == '2024')">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitTargetFramework)' == '' and ('$(RevitVersion)' == '2025' or '$(RevitVersion)' == '2026')">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitTargetFramework)' == '' and '$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <!-- Evaluation-only TFM so the explicit RevitVersion error below is emitted;
         this never selects a Revit version or API path. -->
    <TargetFramework Condition="'$(RevitTargetFramework)' == '' and '$(RevitVersion)' == ''">net10.0-windows</TargetFramework>
    <RootNamespace>DSCons.RevitMcp</RootNamespace>
    <AssemblyName>DSCons.RevitMcp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <RevitRoot Condition="'$(RevitRoot)' == '' and '$(RevitVersion)' != ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitRoot>
    <RevitApiPath Condition="'$(RevitApiPath)' == '' and '$(RevitRoot)' != ''">$(RevitRoot)\RevitAPI.dll</RevitApiPath>
    <RevitApiUiPath Condition="'$(RevitApiUiPath)' == '' and '$(RevitRoot)' != ''">$(RevitRoot)\RevitAPIUI.dll</RevitApiUiPath>
  </PropertyGroup>

  <!-- This assembly is the stable Revit loader. Runtime commands live in
       MCP.CoreRuntime and are loaded from a shadow/byte-copy at runtime. -->
  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="Application.cs" />
    <Compile Include="Core\CoreRuntimeManager.cs" />
    <Compile Include="Core\McpRibbon.cs" />
    <Compile Include="Core\McpRibbonImages.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\contracts\DSCons.RevitMcp.Contracts.csproj" />
    <Reference Include="RevitAPI"><HintPath>$(RevitApiPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitApiUiPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateRevitBuildInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(RevitVersion)' == ''" Text="RevitVersion is required. Pass -p:RevitVersion=2019..2027." />
    <Error Condition="'$(RevitVersion)' != '2019' and '$(RevitVersion)' != '2020' and '$(RevitVersion)' != '2021' and '$(RevitVersion)' != '2022' and '$(RevitVersion)' != '2023' and '$(RevitVersion)' != '2024' and '$(RevitVersion)' != '2025' and '$(RevitVersion)' != '2026' and '$(RevitVersion)' != '2027'" Text="Unsupported RevitVersion '$(RevitVersion)'. Supported values are 2019-2027." />
    <Error Condition="'$(RevitApiPath)' == '' or !Exists('$(RevitApiPath)')" Text="RevitAPI.dll was not found at '$(RevitApiPath)'." />
    <Error Condition="'$(RevitApiUiPath)' == '' or !Exists('$(RevitApiUiPath)')" Text="RevitAPIUI.dll was not found at '$(RevitApiUiPath)'." />
  </Target>
</Project>
